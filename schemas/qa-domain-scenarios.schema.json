{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/qa-domain-scenarios.schema.json",
  "title": "QA Domain Scenarios",
  "type": "object",
  "required": ["project", "scenarios"],
  "properties": {
    "project": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ruleId", "module", "title", "priority", "risk", "actor", "preconditions", "steps", "expectedResults", "layers"],
        "properties": {
          "id": {"type": "string", "pattern": "^QA-"},
          "ruleId": {"type": "string", "pattern": "^BR-[0-9]{3,}$"},
          "module": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "risk": {"enum": ["critical", "high", "medium", "low"]},
          "actor": {"type": "string"},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "expectedResults": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "layers": {"type": "array", "items": {"enum": ["ui", "api", "service", "database", "queue", "integration", "audit", "security", "observability"]}},
          "notApplicableReason": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
